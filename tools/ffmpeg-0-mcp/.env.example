# FFmpeg MCP Server Configuration

## Default Settings
These can be overridden via environment variables

# Path to FFmpeg executable
FFMPEG_PATH=/usr/bin/ffmpeg

# Path to FFprobe executable
FFPROBE_PATH=/usr/bin/ffprobe

# Directory where processed files will be stored
OUTPUT_DIRECTORY=/tmp/ffmpeg_output

# Maximum file size allowed for output (in bytes)
# Default: 100MB (104857600 bytes)
MAX_FILE_SIZE_BYTES=104857600

# Timeout for FFmpeg operations (in seconds)
# Default: 300 seconds (5 minutes)
TIMEOUT_SECONDS=300

## Logging Configuration
# Logs are automatically written to stderr
# Log Level: INFO (debug info available)
LOG_LEVEL=INFO
