# Keep ONLY curated benchmark artifacts; exclude the hundreds of raw experiment files.
/tests/results/*
!/tests/results/all_metrics.csv
!/tests/results/markdowns/
/tests/results/markdowns/*
!/tests/results/markdowns/final_metrics_table.md
!/tests/results/markdowns/comparison_2026-07-01T21-35-33.md
