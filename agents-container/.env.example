# ─────────────────────────────────────────────────────────────────────────────
# VideoSearcher — AgenticAI  |  Agent container environment
# Copy this file to .env and fill in ONE of the options below.
# .env is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Option A: Gemini (recommended, free tier available) ──────────────────────
# GEMINI_API_KEY=your-gemini-api-key-here
# LLM_MODEL=gemini/gemini-2.0-flash

# ── Option B: OpenAI ─────────────────────────────────────────────────────────
# OPENAI_API_KEY=your-openai-api-key-here
# LLM_MODEL=gpt-4o

# ── Option C: Override model for orchestrator only (add-on to A or B) ────────
# LLM_ORCHESTRATOR_MODEL=gemini/gemini-2.0-flash-thinking

# ── Option D: Local LLM for orchestrator (llama.cpp / vLLM / etc.) ───────────
# LLM_ORCHESTRATOR_PROVIDER=openai-chat
# LLM_ORCHESTRATOR_BASE_URL=http://host.docker.internal:9000/v1
# LLM_ORCHESTRATOR_MODEL=gemma-4-E2B-it-Q8_0.gguf
# LLM_ORCHESTRATOR_API_KEY=not-needed
# LLM_MODEL=gemma-4-E2B-it-Q8_0.gguf

# ── Orchestrator log directory (optional, default: data/logs/orchestrator) ───
# ORCHESTRATOR_LOG_DIR=/data/logs/orchestrator

# Setup Git username and email
# GIT_NAME=
# GIT_EMAIL=